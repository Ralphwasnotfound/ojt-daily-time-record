rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function validStudent(d, uid) {
      return d.keys().hasAll(['uid','fullName','studentId','email','role','status','program','requiredHours','createdAt','approvedAt','approvedBy'])
        && d.keys().hasOnly(['uid','fullName','studentId','email','role','status','program','requiredHours','createdAt','approvedAt','approvedBy'])
        && d.uid == uid && d.role == 'student' && d.status == 'pending'
        && d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 100
        && d.studentId is string && d.studentId.matches('^[A-Z0-9][A-Z0-9-]{2,29}$')
        && d.email == request.auth.token.email
        && d.program == 'BS Information Technology'
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && d.requiredHours == 486 && d.createdAt == request.time
        && d.approvedAt == null && d.approvedBy == null;
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || (admin() && resource.data.role == 'student'));
      allow list: if admin() && resource.data.role == 'student';
      allow create: if signedIn() && request.auth.uid == uid
        && validStudent(request.resource.data, uid)
        && !exists(/databases/$(database)/documents/studentIds/$(request.resource.data.studentId))
        && getAfter(/databases/$(database)/documents/studentIds/$(request.resource.data.studentId)).data.uid == uid;
      // Phase 2: self-edit is deliberately disabled. Later allowlist workplace/contact fields
      // only after validation; identity, roles, status and approval metadata stay immutable.
      allow update: if admin() && resource.data.role == 'student' && resource.data.status == 'pending'
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedAt','approvedBy'])
            && request.resource.data.status == 'approved'
            && request.resource.data.approvedAt == request.time
            && request.resource.data.approvedBy == request.auth.uid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'rejected')
        );
      allow delete: if false;
    }
    match /studentIds/{studentId} {
      allow read: if admin();
      allow create: if signedIn()
        && studentId.matches('^[A-Z0-9][A-Z0-9-]{2,29}$')
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId == studentId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'pending';
      // Reservations remain after rejection. Only trusted Console/Admin SDK maintenance can release them.
      allow update, delete: if false;
    }
    // Attendance is separate from account authorization. All writes require approval.
    function approvedStudent() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function manilaDay(t) { return (t + duration.value(8, 'h')).date(); }
    function stateShape(d, uid) {
      return d.keys().hasAll(['studentUid','sessionId','status','timeIn','timeOut','updatedAt'])
        && d.keys().hasOnly(['studentUid','sessionId','status','timeIn','timeOut','updatedAt'])
        && d.studentUid == uid && d.sessionId is string && d.sessionId.size() > 0
        && d.sessionId.matches('^[^/]+$')
        && d.timeIn is timestamp && d.updatedAt is timestamp
        && ((d.status == 'IN' && d.timeOut == null && d.updatedAt == d.timeIn)
          || (d.status == 'OUT' && d.timeOut is timestamp
            && d.timeOut >= d.timeIn && d.updatedAt == d.timeOut));
    }
    function stateMatches(state, session, sessionId) {
      return state.sessionId == sessionId && state.studentUid == session.studentUid
        && state.status == session.status && state.timeIn == session.timeIn
        && state.timeOut == session.timeOut && state.updatedAt == session.updatedAt;
    }
    function newStateSession(d) {
      return d.status == 'IN' && d.timeIn == request.time && d.updatedAt == request.time
        && d.timeOut == null
        && !exists(/databases/$(database)/documents/attendance/$(d.sessionId))
        && stateMatches(d, getAfter(/databases/$(database)/documents/attendance/$(d.sessionId)).data, d.sessionId);
    }
    function previousSessionClosed(d) {
      return d.status == 'OUT'
        && stateMatches(d, get(/databases/$(database)/documents/attendance/$(d.sessionId)).data, d.sessionId)
        && manilaDay(d.timeIn) < manilaDay(request.time);
    }
    function closingState(before, after) {
      return before.status == 'IN' && before.timeOut == null && after.status == 'OUT'
        && after.diff(before).affectedKeys().hasOnly(['status','timeOut','updatedAt'])
        && after.timeOut == request.time && after.updatedAt == request.time
        && after.timeOut >= before.timeIn
        && stateMatches(before, get(/databases/$(database)/documents/attendance/$(before.sessionId)).data, before.sessionId)
        && stateMatches(after, getAfter(/databases/$(database)/documents/attendance/$(before.sessionId)).data, before.sessionId);
    }
    match /attendance/{sessionId} {
      allow read: if admin() || (approvedStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if approvedStudent()
        && request.resource.data.keys().hasAll(['studentUid','studentId','status','timeIn','timeOut','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['studentUid','studentId','status','timeIn','timeOut','createdAt','updatedAt'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId
        && request.resource.data.status == 'IN' && request.resource.data.timeOut == null
        && request.resource.data.timeIn == request.time
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && stateMatches(getAfter(/databases/$(database)/documents/attendanceStates/$(request.auth.uid)).data, request.resource.data, sessionId);
      allow update: if approvedStudent() && resource.data.studentUid == request.auth.uid
        && resource.data.status == 'IN' && resource.data.timeOut == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','timeOut','updatedAt'])
        && request.resource.data.status == 'OUT' && request.resource.data.timeOut == request.time
        && request.resource.data.updatedAt == request.time && request.time >= resource.data.timeIn
        && stateMatches(get(/databases/$(database)/documents/attendanceStates/$(request.auth.uid)).data, resource.data, sessionId)
        && stateMatches(getAfter(/databases/$(database)/documents/attendanceStates/$(request.auth.uid)).data, request.resource.data, sessionId);
      allow delete: if false;
    }
    match /attendanceStates/{uid} {
      // A missing own state is readable, allowing a student's first transaction.
      allow get: if admin() || (approvedStudent() && request.auth.uid == uid);
      allow list: if admin();
      allow create: if approvedStudent() && request.auth.uid == uid
        && stateShape(request.resource.data, uid) && newStateSession(request.resource.data);
      allow update: if approvedStudent() && request.auth.uid == uid
        && stateShape(resource.data, uid) && stateShape(request.resource.data, uid)
        && ((previousSessionClosed(resource.data) && newStateSession(request.resource.data))
          || closingState(resource.data, request.resource.data));
      allow delete: if false;
    }
    // Activities do not mutate attendance or impose a per-day submission limit.
    function activityOpenSession(state, session, sessionId) {
      return stateShape(state, request.auth.uid)
        && state.status == 'IN' && state.timeOut == null
        && session.studentUid == request.auth.uid
        && session.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId
        && session.status == 'IN' && session.timeOut == null
        && session.timeIn is timestamp && session.timeIn <= request.time
        && stateMatches(state, session, sessionId);
    }
    function validActivity(d, activityId) {
      return d.keys().hasAll(['studentUid','studentId','attendanceSessionId','category','description','photoPath','createdAt'])
        && d.keys().hasOnly(['studentUid','studentId','attendanceSessionId','category','description','photoPath','createdAt'])
        && activityId.matches('^[A-Za-z0-9]{20}$')
        && d.studentUid is string && d.studentUid == request.auth.uid
        && d.studentId is string
        && d.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId
        && d.attendanceSessionId is string && d.attendanceSessionId.matches('^[^/]+$')
        && d.category is string && d.category in ['Programming / Development','IT Support','Hardware / Maintenance','Documentation','Training / Seminar','Meeting','Administrative Work','Other']
        && d.description is string && d.description.size() > 0 && d.description.size() <= 500
        // Match JavaScript trim whitespace explicitly; Rules trim omits some Unicode spaces.
        && d.description == d.description.replace('^[\\s\\x{000B}\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]+|[\\s\\x{000B}\\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}]+$', '')
        && d.photoPath is string
        && d.photoPath == 'activityProofs/' + request.auth.uid + '/' + activityId + '/proof'
        && d.createdAt is timestamp && d.createdAt == request.time;
    }
    match /activities/{activityId} {
      // Missing-document reads support transaction creation and uncertain-result reconciliation.
      allow get: if admin() || (approvedStudent()
        && (!exists(/databases/$(database)/documents/activities/$(activityId)) || resource.data.studentUid == request.auth.uid));
      allow list: if admin() || (approvedStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if approvedStudent() && validActivity(request.resource.data, activityId)
        && activityOpenSession(
          get(/databases/$(database)/documents/attendanceStates/$(request.auth.uid)).data,
          get(/databases/$(database)/documents/attendance/$(request.resource.data.attendanceSessionId)).data,
          request.resource.data.attendanceSessionId)
        // Check the final state too: a batch cannot close attendance and submit an activity.
        && activityOpenSession(
          getAfter(/databases/$(database)/documents/attendanceStates/$(request.auth.uid)).data,
          getAfter(/databases/$(database)/documents/attendance/$(request.resource.data.attendanceSessionId)).data,
          request.resource.data.attendanceSessionId);
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
